LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDERS=qwen,kimi,openai
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_DUPLICATE_CALLS=1
AGENT_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=2

# RAG Phase 3: memory để học/test local; dùng postgres khi chạy Docker Compose.
RAG_STORE=memory
RAG_DATABASE_URL=postgresql://agent:agent@localhost:5433/agent_lab
RAG_CHUNK_SIZE_CHARS=800
RAG_CHUNK_OVERLAP_CHARS=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.15
RAG_DENSE_CANDIDATE_K=20
RAG_LEXICAL_CANDIDATE_K=20
RAG_HYBRID_CANDIDATE_K=20
RAG_RRF_K=60
RAG_RETRIEVAL_MODE=hybrid
RAG_HNSW_ITERATIVE_SCAN=strict_order
RERANKER_ENABLED=true
RERANKER_CANDIDATE_K=20
RERANKER_TOP_K=5
RAG_HIGH_RELEVANCE_THRESHOLD=1.0
RAG_MEDIUM_RELEVANCE_THRESHOLD=0.5
RAG_MIN_RERANKER_CONFIDENCE=0.7

# Production dùng semantic embedding OpenAI; local_hash chỉ được inject trong unit test.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_VERSION=2
EMBEDDING_TIMEOUT_SECONDS=30

DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=your-model-studio-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

KIMI_API_KEY=your-moonshot-key
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5

OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
